class Inventory:
    def __init__(self):
        self.items = []

    def add_item(self, name, weight, value):
        item = {"name": name, "weight": weight, "value": value}
        self.items.append(item)

    def remove_item(self, name):
        self.items = [item for item in self.items if item["name"] != name]

    def get_total_weight(self):
        return sum(item["weight"] for item in self.items)

    def get_total_value(self):
        return sum(item["value"] for item in self.items)

    def find_heaviest(self):
        if not self.items: return None
        return max(self.items, key=lambda x: x["weight"])

    def find_most_valuable(self):
        if not self.items: return None
        return max(self.items, key=lambda x: x["value"])

    def sort_by_value(self):
        return sorted(self.items, key=lambda x: x["value"], reverse=True)

    def sort_by_weight(self):
        return sorted(self.items, key=lambda x: x["weight"])

