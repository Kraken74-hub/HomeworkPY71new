class GameCharacter:
    def __init__(self, name, health, level):
        self.name = name
        self.level = level
        self.health = health

    @property
    def health(self):
        return self.__health

    @health.setter
    def health(self, value):
        if value > 100:
            self.__health = 100
        else:
            self.__health = value

    def _level_up(self):
        self.level += 1

    def attack(self, other_character):
        other_character.health -= 10
        print(f"{self.name} атаковал {other_character.name}!")

    @classmethod
    def create_starter(cls, name):
        return cls(name, 100, 1)

    @staticmethod
    def compare_levels(char1, char2):
        if char1.level >= char2.level:
            return char1
        return char2

#2
class Store:
    def __init__(self, name):
        self.name = name
        self.products = []  # Список словарей {"name": ..., "price": ..., "quantity": ...}

    def add_product(self, name, price, quantity):
        self.products.append({
            "name": name,
            "price": price,
            "quantity": quantity
        })

    def remove_product(self, name):
        self.products = [p for p in self.products if p["name"] != name]

    def update_price(self, name, new_price):
        for product in self.products:
            if product["name"] == name:
                product["price"] = new_price
                break

    def sell_product(self, name, quantity):
        for product in self.products:
            if product["name"] == name:
                if product["quantity"] >= quantity:
                    product["quantity"] -= quantity
                    print(f"Продано {quantity} шт. товара {name}")
                else:
                    print("Недостаточно товара на складе")
                return

    def get_inventory(self):
        return {p["name"]: p["quantity"] for p in self.products}

    def find_most_expensive(self):
        if not self.products: return None
        return max(self.products, key=lambda x: x["price"])

    def find_cheapest(self):
        if not self.products: return None
        return min(self.products, key=lambda x: x["price"])

