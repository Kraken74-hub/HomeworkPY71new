from datetime import datetime

class Car:
    def __init__(self, brand, model, year, fuel_level=0, mileage=0):
        self.brand = brand
        self.model = model
        self.year = year
        self.fuel_level = fuel_level
        self.mileage = mileage

    def __check_fuel(self, distance):
        # Расход 0.1 л на 1 км
        required_fuel = distance * 0.1
        return self.fuel_level >= required_fuel

    def drive(self, distance):
        if self.__check_fuel(distance):
            self.mileage += distance
            self.fuel_level -= (distance * 0.1)
            print(f"Проехали {distance} км.")
        else:
            print("Недостаточно топлива для поездки!")

    def refuel(self, liters):
        self.fuel_level += liters
        print(f"Заправлено {liters} л. Текущий уровень: {self.fuel_level} л.")

    def info(self):
        print(f"Авто: {self.brand} {self.model} ({self.year} г.)")
        print(f"Пробег: {self.mileage} км, Топливо: {self.fuel_level} л.")

    def age(self):
        current_year = datetime.now().year
        return current_year - self.year

    @classmethod
    def from_string(cls, data):
        brand, model, year = [item.strip() for item in data.split(',')]
        return cls(brand, model, int(year))

